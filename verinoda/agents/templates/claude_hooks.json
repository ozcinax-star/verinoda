{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "verinoda",
            "tool": "run_tool",
            "input": {
              "name": "grep_context",
              "arguments": {
                "pattern": "${tool_input.pattern}"
              }
            },
            "timeout": 10,
            "statusMessage": "verinoda: graph context"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "verinoda",
            "tool": "run_tool",
            "input": {
              "name": "grep_context",
              "arguments": {
                "command": "${tool_input.command}"
              }
            },
            "timeout": 10,
            "statusMessage": "verinoda: graph context"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "verinoda",
            "tool": "run_tool",
            "input": {
              "name": "read_context",
              "arguments": {
                "file_path": "${tool_input.file_path}"
              }
            },
            "timeout": 10,
            "statusMessage": "verinoda: what the project says about this file"
          }
        ]
      }
    ]
  }
}

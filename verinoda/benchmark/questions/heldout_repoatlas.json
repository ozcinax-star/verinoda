{
  "schema": 1,
  "name": "heldout_repoatlas",
  "description": "Held-out set on RepoAtlas's own source at commit 7371990 (the repoatlas package without the vendored project_index and the benchmark question files, plus tests/ without fixtures): 8 questions, where x2, config, flow, impact, behaviour, why, tests. Questions and gold as written by the retrieval research agent; gold re-anchored to 7371990.",
  "verified_by": "Gold facts were written by the retrieval research agent by reading the RepoAtlas source of its research snapshot; for this set every fact was re-read at commit 7371990 by the measurement agent, its locators re-pointed to the same code (3 facts restated where the code was restructured, see each fact's review), and each source.at/source.contains pair is re-checked against the benchmark copy before scoring (metrics.validate_gold).",
  "provenance": {
    "questions_written_by": "retrieval research agent (round-3 research), after its prototype was built and before the prototype was run on this corpus",
    "gold_written_by": "retrieval research agent, same time",
    "gold_reviewed_by": "measurement agent (round-3 measurement step): every fact re-read and re-anchored to commit 7371990; no fact added or removed, question wording unchanged",
    "in_sample": false,
    "caveat": "held out from RepoAtlas design, not unseen: the search track ran it during development and reports it was not used for tuning",
    "original_file": "retrieval_track/heldout.json (research scratch, not in the repository)"
  },
  "corpus": {
    "snapshot_dir": "benchmarks/corpora/heldout_repoatlas_7371990",
    "source_commit": "73719901c9dea49c2e87120ca040c6b998298fe3",
    "note": "The product was renamed from RepoAtlas to Verinoda after this set was written. The corpus is the RepoAtlas package at commit 7371990 of the pre-rename (private) history, shipped as a snapshot because that history is not in this repository. Run with --repo benchmarks/corpora/heldout_repoatlas_7371990. Gold locators name the old paths (repoatlas/...) on purpose: they refer to that snapshot.",
    "include": [
      "repoatlas",
      "tests"
    ],
    "exclude": [
      "repoatlas/project_index/*",
      "repoatlas/benchmark/questions/*",
      "tests/fixtures/*",
      "*/__pycache__/*"
    ]
  },

         "match_any": [{"loc": "orders/service.py:26"}, {"text": "repo.get(order_id)"}]},
        {"id": "q08.select", "fact": "OrderRepository.get runs SELECT ... FROM orders WHERE id = ? (orders/repository.py:24)",

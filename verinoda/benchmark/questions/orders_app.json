        {"id": "q09.connect", "fact": "sqlite3.connect(url) in OrderRepository.__init__ (orders/repository.py:10)",
         "source": {"at": "orders/repository.py:10", "contains": "sqlite3.connect(url)"},
         "match_any": [{"loc": "orders/repository.py:10"}, {"text": "sqlite3.connect(url)"}]},

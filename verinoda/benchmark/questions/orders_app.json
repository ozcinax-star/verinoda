{
  "schema": 1,
  "name": "orders_app",
  "description": "The Verinoda end-to-end example (examples/orders_app): framework-free HTTP handlers -> service -> pricing / repository -> SQLite, env configuration, pytest tests and one ADR. 10 questions: where x3, flow x2, config, tests, why, impact, behaviour.",
  "verified_by": "Gold facts were written by reading every file of examples/orders_app line by line; each fact's source.at/source.contains pair is re-checked against the benchmark copy before any approach is scored (metrics.validate_gold).",
  "provenance": {
    "questions_written_by": "benchmark harness author (an agent, round 1), before any approach was run on the set",
    "gold_written_by": "same author, by reading every file of examples/orders_app",
    "in_sample": true,
    "caveat": "Verinoda has been developed against this example since round 1 (every track checks it), so Verinoda results on it are in-sample; questions and gold have not changed since 05890a1"
  },
  "corpus": {
    "detect": ["orders/service.py", "orders/repository.py", "docs/adr/0001-sqlite-persistence.md"],
    "include": null,
    "exclude": null
  },
  "questions": [
    {
      "id": "q01", "category": "where",
      "question": "Where is an order written to the database?",
      "facts": [
        {"id": "q01.save", "fact": "OrderRepository.save writes the order (orders/repository.py:15-20)",
         "source": {"at": "orders/repository.py:15", "contains": "def save("},
         "match_any": [{"loc": "orders/repository.py:15-20"}]},
        {"id": "q01.insert", "fact": "the write is an INSERT INTO orders statement (orders/repository.py:17)",
         "source": {"at": "orders/repository.py:17", "contains": "INSERT INTO orders"},
         "match_any": [{"loc": "orders/repository.py:17"}, {"text": "INSERT INTO orders"}]},
        {"id": "q01.commit", "fact": "the transaction is committed right after the insert (orders/repository.py:19)",
         "source": {"at": "orders/repository.py:19", "contains": "self.conn.commit()"},
         "match_any": [{"loc": "orders/repository.py:19"}, {"text": "self.conn.commit()"}]}
      ],
      "negatives": [
        {"id": "q01.n.service_sql", "statement": "place_order talks to SQLite directly (it only calls repo.save)",
         "relation": ["place_order", "calls", "connect|execute|commit"]},
        {"id": "q01.n.sqlite_import", "statement": "service.py or api.py imports sqlite3 (only repository.py does)",
         "relation": ["service.py|api.py", "imports|imports_from", "sqlite3"]}
      ]
    },
    {
      "id": "q02", "category": "flow",
      "question": "What is the call path from the create-order HTTP handler to the database write?",
      "facts": [
        {"id": "q02.handler", "fact": "create_order_handler calls place_order (orders/api.py:18)",
         "source": {"at": "orders/api.py:18", "contains": "place_order(get_repo()"},
         "match_any": [{"loc": "orders/api.py:18"}]},
        {"id": "q02.service", "fact": "place_order calls repo.save (orders/service.py:22)",
         "source": {"at": "orders/service.py:22", "contains": "repo.save(customer, total)"},
         "match_any": [{"loc": "orders/service.py:22"}, {"text": "repo.save("}]},
        {"id": "q02.sink", "fact": "OrderRepository.save executes the INSERT (orders/repository.py:17)",
         "source": {"at": "orders/repository.py:17", "contains": "INSERT INTO orders"},
         "match_any": [{"loc": "orders/repository.py:17"}]}
      ],
      "negatives": [
        {"id": "q02.n.handler_save", "statement": "create_order_handler calls save directly (it goes through place_order)",
         "relation": ["create_order_handler", "calls", "save"]},
        {"id": "q02.n.service_sql", "statement": "place_order talks to SQLite directly",
         "relation": ["place_order", "calls", "connect|execute|commit"]}
      ]
    },
    {
      "id": "q03", "category": "config",
      "question": "Which environment variables configure the orders service and where are they read?",
      "facts": [
        {"id": "q03.db", "fact": "ORDERS_DATABASE_URL is read at orders/config.py:5",
         "source": {"at": "orders/config.py:5", "contains": "ORDERS_DATABASE_URL"},
         "match_any": [{"loc": "orders/config.py:5"}, {"text": "ORDERS_DATABASE_URL"}]},
        {"id": "q03.max", "fact": "ORDERS_MAX_ITEMS is read at orders/config.py:6",
         "source": {"at": "orders/config.py:6", "contains": "ORDERS_MAX_ITEMS"},
         "match_any": [{"loc": "orders/config.py:6"}, {"text": "ORDERS_MAX_ITEMS"}]},
        {"id": "q03.discount", "fact": "ORDERS_DISCOUNT_THRESHOLD is read at orders/config.py:7",
         "source": {"at": "orders/config.py:7", "contains": "ORDERS_DISCOUNT_THRESHOLD"},
         "match_any": [{"loc": "orders/config.py:7"}, {"text": "ORDERS_DISCOUNT_THRESHOLD"}]}
      ],
      "negatives": [
        {"id": "q03.n.repo_env", "statement": "the repository reads an environment variable itself (it imports DATABASE_URL from orders/config.py)",
         "assertion_regex": "(?i)(repository\\.py|OrderRepository)[^\\n]*reads environment variable"}
      ]
    },
    {
      "id": "q04", "category": "tests",
      "question": "Which tests exercise the discount calculation?",
      "facts": [
        {"id": "q04.above", "fact": "test_discount_applies_above_threshold (tests/test_pricing.py:4)",
         "source": {"at": "tests/test_pricing.py:4", "contains": "def test_discount_applies_above_threshold"},
         "match_any": [{"loc": "tests/test_pricing.py:4-5"}, {"text": "test_discount_applies_above_threshold"}]},
        {"id": "q04.below", "fact": "test_no_discount_below_threshold (tests/test_pricing.py:8)",
         "source": {"at": "tests/test_pricing.py:8", "contains": "def test_no_discount_below_threshold"},
         "match_any": [{"loc": "tests/test_pricing.py:8-9"}, {"text": "test_no_discount_below_threshold"}]},
        {"id": "q04.total", "fact": "test_compute_total reaches apply_discount through compute_total (tests/test_pricing.py:12, orders/pricing.py:8)",
         "source": {"at": "tests/test_pricing.py:12", "contains": "def test_compute_total"},
         "match_any": [{"loc": "tests/test_pricing.py:12-13"}, {"text": "test_compute_total"}]},
        {"id": "q04.roundtrip", "fact": "test_place_and_fetch_roundtrip runs place_order -> compute_total -> apply_discount with a non-empty order (tests/test_service.py:7-10)",
         "source": {"at": "tests/test_service.py:9", "contains": "place_order(repo, \"ada\""},
         "match_any": [{"loc": "tests/test_service.py:7-10"}, {"text": "test_place_and_fetch_roundtrip"}]}
      ],
      "negatives": [
        {"id": "q04.n.empty_order", "statement": "test_empty_order_rejected exercises the discount calculation (validate_items raises before compute_total runs)",
         "assertion_regex": "(apply_discount|compute_total|discount)[^\\n]*test_empty_order_rejected|test_empty_order_rejected[^\\n]*(apply_discount|compute_total|discount)"}
      ]
    },
    {
      "id": "q05", "category": "why",
      "question": "Why does the project use SQLite for persistence?",
      "facts": [
        {"id": "q05.zero_ops", "fact": "ADR 0001: chosen for zero-ops local development (docs/adr/0001-sqlite-persistence.md:6)",
         "source": {"at": "docs/adr/0001-sqlite-persistence.md:6", "contains": "zero-ops local development"},
         "match_any": [{"loc": "docs/adr/0001-sqlite-persistence.md:6"}, {"text": "zero-ops"}]},
        {"id": "q05.accepted", "fact": "the decision is accepted (docs/adr/0001-sqlite-persistence.md:3)",
         "source": {"at": "docs/adr/0001-sqlite-persistence.md:3", "contains": "Status: accepted"},
         "match_any": [{"loc": "docs/adr/0001-sqlite-persistence.md:3"}, {"text": "Status: accepted"}]},
        {"id": "q05.only_repo", "fact": "only OrderRepository may open a database connection (docs/adr/0001-sqlite-persistence.md:5-6)",
         "source": {"at": "docs/adr/0001-sqlite-persistence.md:5", "contains": "No other module"},
         "match_any": [{"loc": "docs/adr/0001-sqlite-persistence.md:5-6"}, {"text": "No other module"}]}
      ],
      "negatives": []
    },
    {
      "id": "q06", "category": "impact",
      "question": "What needs retesting if OrderRepository.save changes?",
      "facts": [
        {"id": "q06.caller", "fact": "place_order calls repo.save (orders/service.py:22)",
         "source": {"at": "orders/service.py:22", "contains": "repo.save("},
         "match_any": [{"loc": "orders/service.py:22"}, {"text": "repo.save("}]},
        {"id": "q06.handler", "fact": "create_order_handler reaches save through place_order (orders/api.py:18)",
         "source": {"at": "orders/api.py:18", "contains": "place_order("},
         "match_any": [{"loc": "orders/api.py:18"}]},
        {"id": "q06.test", "fact": "test_place_and_fetch_roundtrip saves through place_order (tests/test_service.py:7-10)",
         "source": {"at": "tests/test_service.py:7", "contains": "def test_place_and_fetch_roundtrip"},
         "match_any": [{"loc": "tests/test_service.py:7-10"}, {"text": "test_place_and_fetch_roundtrip"}]}
      ],
      "negatives": [
        {"id": "q06.n.read_path", "statement": "the read path (fetch_order / get_order_handler) calls save",
         "relation": ["fetch_order|get_order_handler", "calls", "save"]},
        {"id": "q06.n.pricing", "statement": "changing the repository affects orders/pricing.py (pricing does not depend on the repository)",
         "assertion_regex": "(?i)affect[^\\n]*orders/pricing\\.py"}
      ]
    },
    {
      "id": "q07", "category": "where",
      "question": "Where is the 10% discount applied and what threshold controls it?",
      "facts": [
        {"id": "q07.apply", "fact": "apply_discount multiplies by 0.9 above the threshold (orders/pricing.py:11-15)",
         "source": {"at": "orders/pricing.py:14", "contains": "subtotal * 0.9"},
         "match_any": [{"loc": "orders/pricing.py:11-15"}, {"text": "subtotal * 0.9"}]},
        {"id": "q07.threshold", "fact": "the threshold is DISCOUNT_THRESHOLD from ORDERS_DISCOUNT_THRESHOLD (orders/config.py:7)",
         "source": {"at": "orders/config.py:7", "contains": "ORDERS_DISCOUNT_THRESHOLD"},
         "match_any": [{"loc": "orders/config.py:7"}, {"text": "ORDERS_DISCOUNT_THRESHOLD"}]},
        {"id": "q07.caller", "fact": "compute_total applies it to the subtotal (orders/pricing.py:8)",
         "source": {"at": "orders/pricing.py:8", "contains": "apply_discount(subtotal)"},
         "match_any": [{"loc": "orders/pricing.py:8"}, {"text": "apply_discount(subtotal)"}]}

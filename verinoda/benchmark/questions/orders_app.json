         "source": {"at": "orders/repository.py:9", "contains": "url: str = DATABASE_URL"},
         "match_any": [{"loc": "orders/repository.py:9"}, {"text": "url: str = DATABASE_URL"}]},
        {"id": "q09.env", "fact": "DATABASE_URL comes from ORDERS_DATABASE_URL, default orders.db (orders/config.py:5)",
         "source": {"at": "orders/config.py:5", "contains": "ORDERS_DATABASE_URL"},

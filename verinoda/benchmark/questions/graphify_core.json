{
  "schema": 1,
  "name": "graphify_core",
  "description": "Upstream Graphify at commit 20a20d30 (the Verinoda-independent checkout): the whole graphify/ package (~225 files, ~49k lines of Python in the top-level modules plus extractors, skills and docs) and two of its test modules. 9 questions: where x2, flow x2, config x2, why, impact, tests.",
  "verified_by": "Gold facts were written by reading the upstream source at commit 20a20d30d8e7eef77675651f0199d87f913bd3e7 (graphify/serve.py, cli.py, querylog.py, cache.py, security.py, watch.py, benchmark.py, tests/test_security.py); each fact's source.at/source.contains pair is re-checked against the benchmark copy before scoring (metrics.validate_gold).",
  "provenance": {
    "questions_written_by": "benchmark harness author (an agent, round 1), before any approach was run on the set",
    "gold_written_by": "same author, by reading the upstream source at 20a20d30",
    "in_sample": true,
    "caveat": "the round-3 retrieval design was made after seeing Verinoda's misses on this set (docs/DESIGN.md 3.1), so Verinoda results on it are in-sample; questions and gold have not changed since 05890a1"
  },
  "corpus": {
    "detect": ["graphify/serve.py", "graphify/cli.py", "graphify/querylog.py"],
    "include": ["graphify", "tests/test_security.py", "tests/test_querylog.py", "pyproject.toml"],
    "exclude": ["*/__pycache__/*"]
  },
  "questions": [
    {
      "id": "g01", "category": "where",
      "question": "Where is graphify query output cut to fit the token budget?",
      "facts": [
        {"id": "g01.func", "fact": "_subgraph_to_text renders and cuts the subgraph (graphify/serve.py:1075)",
         "source": {"at": "graphify/serve.py:1075", "contains": "def _subgraph_to_text("},
         "match_any": [{"loc": "graphify/serve.py:1075-1081"}, {"text": "_subgraph_to_text"}]},
        {"id": "g01.ratio", "fact": "the token budget becomes a char budget at 3 chars/token (graphify/serve.py:1081)",
         "source": {"at": "graphify/serve.py:1081", "contains": "char_budget = token_budget * 3"},
         "match_any": [{"loc": "graphify/serve.py:1081"}, {"text": "token_budget * 3"}]},
        {"id": "g01.cut", "fact": "output longer than the char budget is cut at the last newline (graphify/serve.py:1200-1202)",
         "source": {"at": "graphify/serve.py:1200", "contains": "if len(output) > char_budget:"},
         "match_any": [{"loc": "graphify/serve.py:1200-1202"}]},
        {"id": "g01.caller", "fact": "_query_graph_text calls it with the seeds (graphify/serve.py:1408)",
         "source": {"at": "graphify/serve.py:1408", "contains": "_subgraph_to_text(traversal_graph"},
         "match_any": [{"loc": "graphify/serve.py:1408"}]}
      ],
      "negatives": [
        {"id": "g01.n.reversed", "statement": "_subgraph_to_text calls _query_graph_text (direction reversed)",
         "relation": ["_subgraph_to_text", "calls", "_query_graph_text"]}
      ]
    },
    {

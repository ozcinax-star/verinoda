{
  "about": "Library behaviour as data for `verinoda taint` (Python): where untrusted values enter (sources, each remote - a request from the network - or local - the user running the program: argv, the environment, input(); local ones are used with --local), calls that must not receive them unchecked (sinks, with the argument that matters by position and keyword; when_keyword: only with that keyword true; safe_keywords: not with one of these values), and calls whose result is safe to pass on (sanitizers, to every sink or to the kinds listed). A name `a.b` matches an attribute chain or name ending in `.a.b`; `a.b()` matches a call of it; `*.m` any receiver's method `m`. Route handler parameters taken from the request are sources too (verinoda reads the route decorators). A project adds to or replaces these in verinoda.toml [taint].",
  "sources": [
    {
      "match": "request.args",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.form",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.values",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.json",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.get_json()",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.data",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.files",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.cookies",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.headers",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.GET",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.POST",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.body",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.query_params",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.path_params",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "input()",
      "kind": "user",
      "threat": "local"
    },
    {
      "match": "sys.argv",
      "kind": "argv",
      "threat": "local"
    },
    {
      "match": "os.environ",
      "kind": "environment",
      "threat": "local"
    },
    {
      "match": "os.getenv()",
      "kind": "environment",
      "threat": "local"
    },
    {
      "match": "request.COOKIES",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.FILES",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.META",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.get_data()",
      "kind": "http",
      "threat": "remote"
    },
    {
      "match": "request.view_args",
      "kind": "http",
      "threat": "remote"
    }
  ],
  "sinks": [
    {
      "match": "*.execute",
      "arg": 0,
      "kind": "sql",
      "keyword": "sql"
    },
    {
      "match": "*.executemany",
      "arg": 0,
      "kind": "sql",
      "keyword": "sql"
    },
    {
      "match": "*.executescript",
      "arg": 0,
      "kind": "sql",
      "keyword": "sql_script"
    },
    {
      "match": "*.raw",
      "arg": 0,
      "kind": "sql",
      "keyword": "raw_query"
    },
    {
      "match": "os.system",
      "arg": 0,
      "kind": "command",
      "keyword": "command"
    },
    {
      "match": "os.popen",
      "arg": 0,
      "kind": "command",
      "keyword": "cmd"
    },
    {
      "match": "subprocess.run",
      "arg": 0,
      "kind": "command",
      "when_keyword": "shell",
      "keyword": "args"
    },
    {
      "match": "subprocess.call",
      "arg": 0,
      "kind": "command",
      "when_keyword": "shell",
      "keyword": "args"
    },
    {
      "match": "subprocess.Popen",
      "arg": 0,
      "kind": "command",
      "when_keyword": "shell",
      "keyword": "args"
    },
    {
      "match": "subprocess.check_output",
      "arg": 0,
      "kind": "command",
      "when_keyword": "shell",
      "keyword": "args"
    },
    {
      "match": "subprocess.check_call",
      "arg": 0,
      "kind": "command",
      "when_keyword": "shell",
      "keyword": "args"
    },
    {
      "match": "eval",
      "arg": 0,
      "kind": "code"
    },
    {
      "match": "exec",
      "arg": 0,
      "kind": "code"
    },
    {
      "match": "pickle.loads",
      "arg": 0,
      "kind": "deserialization",
      "keyword": "data"
    },
    {
      "match": "yaml.load",
      "arg": 0,
      "kind": "deserialization",
      "keyword": "stream",
      "safe_keywords": {
        "Loader": [
          "SafeLoader",
          "CSafeLoader",
          "BaseLoader"
        ]
      }
    },
    {
      "match": "open",
      "arg": 0,
      "kind": "path",
      "keyword": "file"
    },
    {
      "match": "send_file",
      "arg": 0,
      "kind": "path",
      "keyword": "path_or_file"
    },
    {
      "match": "render_template_string",
      "arg": 0,
      "kind": "template",
      "keyword": "source"
    },
    {
      "match": "redirect",
      "arg": 0,
      "kind": "redirect",
      "keyword": "location"
    },
    {
      "match": "requests.get",
      "arg": 0,
      "kind": "request",
      "keyword": "url"
    },
    {
      "match": "requests.post",
      "arg": 0,
      "kind": "request",
      "keyword": "url"
    },
    {
      "match": "urllib.request.urlopen",
      "arg": 0,
      "kind": "request",
      "keyword": "url"
    },
    {
      "match": "subprocess.getoutput",
      "arg": 0,
      "kind": "command",
      "keyword": "cmd"
    },
    {
      "match": "subprocess.getstatusoutput",
      "arg": 0,
      "kind": "command",
      "keyword": "cmd"
    },
    {
      "match": "marshal.loads",
      "arg": 0,
      "kind": "deserialization"
    },
    {
      "match": "jinja2.Template",
      "arg": 0,
      "kind": "template",
      "keyword": "source"
    },
    {
      "match": "Markup",
      "arg": 0,
      "kind": "xss",
      "keyword": "base"
    },
    {
      "match": "httpx.get",
      "arg": 0,
      "kind": "request",
      "keyword": "url"
    },
    {
      "match": "httpx.post",
      "arg": 0,
      "kind": "request",
      "keyword": "url"
    },
    {
      "match": "sqlalchemy.text",
      "arg": 0,
      "kind": "sql",
      "keyword": "text"
    }
  ],
  "sanitizers": [
    "int()",
    "float()",
    "bool()",
    "len()",
    "uuid.UUID()",
    {
      "match": "shlex.quote()",
      "kinds": [
        "command"
      ]
    },
    {
      "match": "html.escape()",
      "kinds": [
        "template",
        "xss"
      ]
    },
    {
      "match": "markupsafe.escape()",
      "kinds": [
        "template",
        "xss"
      ]
    },
    {
      "match": "os.path.basename()",
      "kinds": [
        "path"
      ]
    },
    {
      "match": "secure_filename()",
      "kinds": [
        "path"
      ]
    }
  ]
}

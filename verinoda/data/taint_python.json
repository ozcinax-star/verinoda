    },
    {
      "match": "httpx.get",
      "arg": 0,
      "kind": "request"
    },
    {
      "match": "httpx.post",
      "arg": 0,
      "kind": "request"
    },
    {
      "match": "sqlalchemy.text",
      "arg": 0,
      "kind": "sql"
    }
  ],
  "sanitizers": [
    "int()",
    "float()",
    "bool()",
    "len()",
    "shlex.quote()",
    "html.escape()",
    "markupsafe.escape()",
    "escape()",
    "os.path.basename()",
    "secure_filename()",
    "werkzeug.utils.secure_filename()",
    "uuid.UUID()"
  ]
}

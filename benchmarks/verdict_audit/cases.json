{
  "schema": "verinoda.verdict_audit/1",
  "about": "Questions where `verinoda analyze` said 'met' for an irrelevant or incomplete answer (traps), and questions where 'met' is right (controls). Public material only. The split was fixed before any verdict rule was changed; rules are tuned on dev only. See README.md.",
  "projects": {
    "glow_mod": {"source": "examples/glow_mod",
                 "verinoda_config": {"index": {"reference": [{"path": "reference/",
                                                              "aliases": ["original", "plugin", "paper", "orijinal", "eklenti"]}]}}},
    "forge_mod": {"source": "examples/forge_mod"},
    "orders_app": {"source": "examples/orders_app"},
    "pyloop": {"source": "tests/fixtures/verdict_audit/pyloop",
               "verinoda_config": {"index": {"reference": [{"path": "reference/", "aliases": ["old", "oldloop", "eski"]}]}}},
    "webui": {"source": "tests/fixtures/verdict_audit/webui"},
    "mixmod": {"source": "tests/fixtures/verdict_audit/mixmod"},
    "verinoda": {"source": ".", "git_commit": "343a00d",
                 "include": ["verinoda", "benchmarks/corpora", "docs", "tests", "pyproject.toml", "README.md"],
                 "exclude": ["verinoda/project_index/*", "*/__pycache__/*", "verinoda/benchmark/questions/*"]}
  },
  "cases": [
    {"id": "pyloop-callsoon-callers", "split": "dev", "kind": "trap", "shape": "unresolved_method_calls",
     "project": "pyloop", "question": "what calls BaseLoop.call_soon?", "ceiling": "met_with_inference",
     "gold": {"must": ["loop/base.py:26", "loop/base.py:35", "loop/transport.py:9", "loop/transport.py:12", "loop/transport.py:19"]},
     "note": "every call is self.call_soon or self._loop.call_soon; the graph resolves none of them to BaseLoop.call_soon"},
    {"id": "pyloop-why-pause", "split": "dev", "kind": "trap", "shape": "why_blame",
     "project": "pyloop", "question": "why does Transport pause reading?", "ceiling": "met_with_inference",
     "gold": {"met_is_wrong": true},
     "note": "no comment, doc or decision record states a reason; only the commit that added the file exists"},
    {"id": "pyloop-copy-env", "split": "dev", "kind": "trap", "shape": "copy_tree",
     "project": "pyloop", "question": "which environment variable sets the timer resolution?", "ceiling": "met_with_inference",
     "gold": {"must": ["loop/base.py"]},
     "note": "the project's resolution is a constant (loop/base.py:6); only the reference tree reads an environment variable"},
    {"id": "webui-openpalette", "split": "dev", "kind": "trap", "shape": "listener_caller",
     "project": "webui", "question": "What calls openPalette?", "ceiling": "met_with_inference",
     "gold": {"must": ["static/app.js:17", "static/app.js:35"]},
     "note": "the Ctrl+K keydown listener (app.js:35) calls it from an anonymous callback the graph drops"},
    {"id": "webui-useauth-components", "split": "dev", "kind": "trap", "shape": "hook_usage",
     "project": "webui", "question": "Which React components use the useAuth hook?", "ceiling": "met_with_inference",
     "gold": {"must": ["LoginButton", "ProfileMenu"]},
     "note": "the answer must name the components that call the hook, not where the hook is defined"},
    {"id": "mixmod-unlisted", "split": "dev", "kind": "trap", "shape": "set_difference",
     "project": "mixmod", "question": "Which mixin classes are not listed in mixmod.mixins.json?", "ceiling": "not_met",
     "gold": {"must": ["LivingEntityMixin"], "must_not": ["ServerWorldMixin", "PlayerEntityMixin", "InGameHudMixin"]},
     "note": "a set difference between the mixin classes and the config's lists; no handler computes it"},
    {"id": "glow-wisp-ticked", "split": "dev", "kind": "trap", "shape": "no_override",
     "project": "glow_mod", "question": "where is the Wisp ticked?", "ceiling": "met_with_inference",
     "gold": {"met_is_wrong": true},
     "note": "Wisp does not override tick(); the game's entity tick runs it (outside the repository)"},
    {"id": "glow-why-heart", "split": "dev", "kind": "trap", "shape": "why_blame",
     "project": "glow_mod", "question": "why does the Wisp drop a heart?", "ceiling": "met_with_inference",
     "gold": {"met_is_wrong": true},
     "note": "the code shows how (wisp_death.mcfunction), nothing states why"},
    {"id": "verinoda-stale-decision", "split": "dev", "kind": "trap", "shape": "copy_tree",
     "project": "verinoda", "question": "how does update decide which claims become stale?", "ceiling": "met_with_inference",
     "gold": {"must": ["verinoda/claims.py"]},
     "note": "the answer is claims.invalidate_stale / assess_change; env reads in the frozen benchmark copy are not it"},
    {"id": "verinoda-lock-why", "split": "dev", "kind": "trap", "shape": "why_blame",
     "project": "verinoda", "question": "Why are MCP tool calls serialised with a lock?", "ceiling": "met_with_inference",
     "gold": {"must": ["stdout redirection"]},
     "note": "the reason is in the server module docstring (verinoda/mcp/server.py:44); a commit line is not a reason"},

    {"id": "mixmod-unlisted-tr", "split": "held_out", "kind": "trap", "shape": "set_difference",
     "project": "mixmod", "question": "mixmod.mixins.json dosyasında listelenmemiş mixin sınıfları hangileri?", "ceiling": "not_met",
     "gold": {"must": ["LivingEntityMixin"], "must_not": ["ServerWorldMixin", "PlayerEntityMixin", "InGameHudMixin"]}},
    {"id": "mixmod-spark-ticked", "split": "held_out", "kind": "trap", "shape": "no_override",
     "project": "mixmod", "question": "where is the Spark ticked?", "ceiling": "met_with_inference",
     "gold": {"met_is_wrong": true},
     "note": "Spark has no tick method; EmberLamp.tick is another class"},
    {"id": "verinoda-openpalette", "split": "held_out", "kind": "trap", "shape": "listener_caller",
     "project": "verinoda", "question": "What calls openPalette in the notes page JavaScript?", "ceiling": "met_with_inference",
     "gold": {"must": ["app.js:1698", "app.js:2061"]}},
    {"id": "orders-not-called-by-handlers", "split": "held_out", "kind": "trap", "shape": "set_difference",
     "project": "orders_app", "question": "Which functions in orders/service.py are not called by the HTTP handlers?", "ceiling": "not_met",
     "gold": {"must": ["validate_items"], "must_not": ["place_order", "fetch_order"]}},
    {"id": "orders-why-commit", "split": "held_out", "kind": "trap", "shape": "why_blame",
     "project": "orders_app", "question": "Why does OrderRepository commit after every insert?", "ceiling": "met_with_inference",
     "gold": {"met_is_wrong": true},
     "note": "the ADR is about SQLite and who may open a connection, not about committing"},
    {"id": "pyloop-callsoon-callers-tr", "split": "held_out", "kind": "trap", "shape": "unresolved_method_calls",
     "project": "pyloop", "question": "BaseLoop.call_soon kimler tarafından çağrılıyor?", "ceiling": "met_with_inference",
     "gold": {"must": ["loop/base.py:26", "loop/base.py:35", "loop/transport.py:9", "loop/transport.py:12", "loop/transport.py:19"]}},
    {"id": "webui-useauth-components-tr", "split": "held_out", "kind": "trap", "shape": "hook_usage",
     "project": "webui", "question": "useAuth hook'unu hangi bileşenler kullanıyor?", "ceiling": "met_with_inference",
     "gold": {"must": ["LoginButton", "ProfileMenu"]}},

    {"id": "pyloop-schedule-callers", "split": "dev", "kind": "control", "shape": "clean_callers",
     "project": "pyloop", "question": "what calls schedule_task?", "ceiling": "met",
     "gold": {"must": ["plan_nightly", "plan_hourly"]}},
    {"id": "pyloop-why-adr", "split": "dev", "kind": "control", "shape": "why_record",
     "project": "pyloop", "question": "why do callbacks queued with call_soon run on the next pass?", "ceiling": "met",
     "gold": {"must": ["0001-callbacks-run-on-the-next-pass.md"]}},
    {"id": "webui-renderlist-callers", "split": "dev", "kind": "control", "shape": "clean_callers",
     "project": "webui", "question": "What calls renderList?", "ceiling": "met",
     "gold": {"must": ["init"]}},
    {"id": "mixmod-lamp-ticked", "split": "dev", "kind": "control", "shape": "action_site",
     "project": "mixmod", "question": "where is the EmberLamp ticked?", "ceiling": "met",
     "gold": {"must": ["EmberLamp.java"]}},
    {"id": "glow-config-load-callers", "split": "dev", "kind": "control", "shape": "clean_callers",
     "project": "glow_mod", "question": "Who calls GlowConfig.load?", "ceiling": "met",
     "gold": {"must": ["GlowMod.java:21", "GlowCommands.java:45"]}},
    {"id": "glow-wisp-defined", "split": "dev", "kind": "control", "shape": "clean_locate",
     "project": "glow_mod", "question": "where is Wisp defined?", "ceiling": "met",
     "gold": {"must": ["src/main/java/com/example/glowmod/entity/Wisp.java"]}},
    {"id": "glow-plugin-blockspertick", "split": "dev", "kind": "control", "shape": "named_reference",
     "project": "glow_mod", "question": "Where is blocksPerTick defined in the original plugin?", "ceiling": "met",
     "gold": {"must": ["reference/original-plugin/src/main/java/com/example/glowplugin/GlowPlugin.java"]},
     "note": "the question names the reference tree: an answer from it is what was asked"},
    {"id": "forge-addheat-callers", "split": "dev", "kind": "control", "shape": "clean_callers",
     "project": "forge_mod", "question": "Who calls HeatMath.addHeat?", "ceiling": "met",
     "gold": {"must": ["EmberForgeBlockEntity.java:82", "EmberForgeBlockEntity.java:141", "HeatMath.kt:22", "HeatMathTest.java:2"]}},
    {"id": "forge-blockentity-ticked", "split": "dev", "kind": "control", "shape": "action_site",
     "project": "forge_mod", "question": "where is the EmberForgeBlockEntity ticked?", "ceiling": "met",
     "gold": {"must": ["serverTick"]}},
    {"id": "orders-why-sqlite", "split": "dev", "kind": "control", "shape": "why_record",
     "project": "orders_app", "question": "Why does the project use SQLite for persistence?", "ceiling": "met",
     "gold": {"must": ["0001-sqlite-persistence.md"]}},
    {"id": "orders-place-order-callers", "split": "dev", "kind": "control", "shape": "clean_callers",
     "project": "orders_app", "question": "Who calls place_order?", "ceiling": "met",
     "gold": {"must": ["create_order_handler", "test_service.py"]}},
    {"id": "verinoda-invalidate-callers", "split": "dev", "kind": "control", "shape": "clean_callers",
     "project": "verinoda", "question": "what calls invalidate_stale?", "ceiling": "met",
     "gold": {"must": ["workflow.py:45", "workflow.py:161", "workflow.py:259", "workflow.py:322", "staleness.py:405"]}},
    {"id": "verinoda-detect-defined", "split": "dev", "kind": "control", "shape": "clean_locate",
     "project": "verinoda", "question": "where is detect defined in copies.py?", "ceiling": "met",
     "gold": {"must": ["verinoda/copies.py:72"]}},

    {"id": "pyloop-resolution-defined", "split": "held_out", "kind": "control", "shape": "clean_locate",
     "project": "pyloop", "question": "where is TIMER_RESOLUTION defined?", "ceiling": "met",
     "gold": {"must": ["loop/base.py"]}},
    {"id": "webui-useauth-defined", "split": "held_out", "kind": "control", "shape": "clean_locate",
     "project": "webui", "question": "Where is the useAuth hook defined?", "ceiling": "met",
     "gold": {"must": ["src/hooks/useAuth.ts"]}},
    {"id": "mixmod-mixin-defined", "split": "held_out", "kind": "control", "shape": "clean_locate",
     "project": "mixmod", "question": "Where is ServerWorldMixin defined?", "ceiling": "met",
     "gold": {"must": ["ServerWorldMixin.java"]}},
    {"id": "mixmod-coolall-callers", "split": "held_out", "kind": "control", "shape": "clean_callers",
     "project": "mixmod", "question": "What calls EmberLamp.coolAll?", "ceiling": "met",
     "gold": {"must": ["ServerWorldMixin"]}},
    {"id": "glow-items-registered", "split": "held_out", "kind": "control", "shape": "action_site",
     "project": "glow_mod", "question": "Where are the mod's items registered?", "ceiling": "met",
     "gold": {"must": ["ModItems.java"]}},
    {"id": "forge-maxheat-declared", "split": "held_out", "kind": "control", "shape": "clean_locate",
     "project": "forge_mod", "question": "Where is max_heat declared?", "ceiling": "met",
     "gold": {"must": ["EmberConfig.java"]}},
    {"id": "orders-env-config", "split": "held_out", "kind": "control", "shape": "clean_config",
     "project": "orders_app", "question": "Which environment variables configure the orders service?", "ceiling": "met",
     "gold": {"must": ["ORDERS_DATABASE_URL", "ORDERS_MAX_ITEMS", "ORDERS_DISCOUNT_THRESHOLD"]}},
    {"id": "orders-order-written", "split": "held_out", "kind": "control", "shape": "clean_locate",
     "project": "orders_app", "question": "Where is an order written to the database?", "ceiling": "met",
     "gold": {"must": ["repository.py"]}},
    {"id": "verinoda-mcp-size-env", "split": "held_out", "kind": "control", "shape": "clean_config",
     "project": "verinoda", "question": "Which environment variable sets the MCP response size limit?", "ceiling": "met",
     "gold": {"must": ["VERINODA_MCP_MAX_CHARS"]}}
  ]
}
